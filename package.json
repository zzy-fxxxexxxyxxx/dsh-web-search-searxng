{
  "name": "@zzy-fxxxexxxyxxx/dsh-web-search-searxng",
  "description": "SearXNG-backed search provider for the DeepSeek Harness web capability seam (ctx.web)",
  "version": "0.1.1",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/provider.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "searxng",
    "web-search"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-web": "0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "types": "lib/types/index.d.ts",
  "scripts": {
    "test": "node test/provider.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzy-fxxxexxxyxxx/dsh-web-search-searxng.git"
  },
  "bugs": {
    "url": "https://github.com/zzy-fxxxexxxyxxx/dsh-web-search-searxng/issues"
  },
  "homepage": "https://github.com/zzy-fxxxexxxyxxx/dsh-web-search-searxng#readme",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
